
* { box-sizing: border-box; }
body { margin: 0; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #f8fafc; color: #0f172a; }
.app { max-width: 1180px; margin: 0 auto; padding: 32px 16px; }
.hero, .card { background: white; border: 1px solid #e2e8f0; border-radius: 28px; box-shadow: 0 1px 2px rgba(15,23,42,.04); }
.hero { padding: 28px; display: flex; justify-content: space-between; gap: 20px; align-items: center; margin-bottom: 24px; }
.badge { display: inline-flex; gap: 8px; align-items: center; background: #f1f5f9; color: #475569; padding: 6px 10px; border-radius: 999px; font-size: 14px; }
h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1; margin: 16px 0 12px; letter-spacing: -0.04em; }
p { color: #475569; line-height: 1.6; }
.status { background: #020617; color: white; border-radius: 20px; padding: 18px; min-width: 240px; }
.status span, .status small { display: block; color: #cbd5e1; }
.status strong { display: block; font-size: 20px; margin: 4px 0; }
.grid { display: grid; grid-template-columns: 2fr 3fr; gap: 24px; }
.card { padding: 24px; margin-bottom: 24px; }
h2 { display: flex; align-items: center; gap: 8px; margin: 0 0 18px; }
.row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
label { display: grid; gap: 8px; color: #475569; font-size: 14px; }
input { border: 1px solid #e2e8f0; border-radius: 16px; padding: 13px 14px; font-size: 16px; outline: none; }
input:focus { box-shadow: 0 0 0 3px #cbd5e1; }
button { border: 0; border-radius: 16px; padding: 12px 14px; font-weight: 650; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: #f1f5f9; color: #0f172a; }
button:disabled { opacity: .45; cursor: not-allowed; }
.primary { width: 100%; background: #020617; color: white; margin: 18px 0; padding: 16px; }
.examples { display: grid; gap: 10px; }
.examples button { display: grid; justify-content: start; text-align: left; background: white; border: 1px solid #e2e8f0; }
.examples span { color: #64748b; font-size: 13px; }
.toolbar { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
.toolbar > div { display: flex; gap: 8px; flex-wrap: wrap; }
.result { border: 1px solid #e2e8f0; border-radius: 22px; padding: 20px; background: #f8fafc; }
.label, .source { font-size: 14px; color: #64748b; margin: 0; }
.result h2 { font-size: 28px; margin: 4px 0 4px; }
.result h3 { margin: 20px 0 6px; }
.variants { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 18px 0; }
.variants div { background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 12px; font-weight: 600; }
.empty { border: 1px dashed #cbd5e1; color: #64748b; border-radius: 20px; padding: 48px; text-align: center; }
.error { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; border-radius: 16px; padding: 12px; display: flex; gap: 8px; align-items: center; }
.approved { display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid #e2e8f0; padding: 12px 0; }
.approved span { color: #64748b; font-size: 14px; }
code { background: #f1f5f9; padding: 2px 6px; border-radius: 6px; }
@media (max-width: 850px) {
  .hero, .toolbar, .approved { flex-direction: column; align-items: stretch; }
  .grid, .row, .variants { grid-template-columns: 1fr; }
}
